DATABASE_URL=postgres://user:password@localhost:5432/mfv01
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Set to "require" behind a proxy/managed Postgres that terminates TLS.
PGSSL=
# Max connections in the pool per Node process.
PGPOOL_MAX=10

# server.mjs (production Node adapter) — serving itself is delegated to
# vinext's own prod server; these just control how it binds and how much
# it trusts a reverse proxy in front of it.
PORT=8080
HOST=127.0.0.1
# Set to 1 once you're actually behind a reverse proxy (nginx/caddy) that
# sets X-Forwarded-Proto/Host — lets vinext resolve the real public origin
# (used by the app's CSRF origin check) instead of assuming plain http on
# HOST:PORT. Leave at 0 for local testing without a proxy.
VINEXT_TRUST_PROXY=0
# How many reverse proxies sit in front of the app; used to pick the real
# client IP out of X-Forwarded-For for login rate limiting / IP blocking.
# 0 = trust only the raw TCP connection (no proxy in front — the IP/account
# lockout features degrade to one shared "unknown" bucket in that case).
TRUSTED_PROXY_COUNT=0

# scripts/seed-users.mjs — required, no defaults. Choose real passwords.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_USER_PASSWORD=
