DATABASE_URL=postgres://user:password@localhost:5432/mfv01
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Set to "require" behind a proxy/managed Postgres that terminates TLS.
PGSSL=
# Max connections in the pool per Node process.
PGPOOL_MAX=10

# server.mjs (production Node adapter)
PORT=8080
HOST=127.0.0.1
# Public URL users hit (through your reverse proxy), used for the CSRF
# origin check. Leave unset only for local testing on http://HOST:PORT.
PUBLIC_ORIGIN=
# Set to "true" once you're actually behind a TLS-terminating proxy.
TRUST_TLS_PROXY=false
# How many reverse proxies sit in front of the app; used to pick the real
# client IP out of X-Forwarded-For for login rate limiting. 0 = trust the
# raw TCP connection only (no proxy in front).
TRUSTED_PROXY_COUNT=0

# scripts/seed-users.mjs — required, no defaults. Choose real passwords.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_USER_PASSWORD=
